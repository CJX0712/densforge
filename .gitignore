# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Test and coverage artefacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.junit.xml

# Benchmark artefacts. These are regenerated by `densforge bench`, are
# environment-specific (sample counts, seeds, thread count), and a stale one
# committed by accident is worse than none at all.
benchmark.json
benchmark.json.tmp

# Data and model caches
data/cache/
models/
*.pt
*.pth
*.pkl
*.joblib
*.npy
*.npz

# Secrets. Never commit these, and never let a benchmark write them.
.env
*.key
*.pem
secrets/

# Editor and OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Scratch verification probes (not part of the package)
_probe/
.gitignore.tmp
